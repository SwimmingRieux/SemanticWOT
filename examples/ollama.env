# Runtime backend settings. Copy ONE provider example to .env.
# Existing external Ollama; see docs/docker.md for host binding/firewall setup.
WOT_ENDPOINT=http://host.docker.internal:11434
# Defaults: nomic-embed-text, 768 dimensions, batch size 32.
# Pull the model yourself before requesting a feed: ollama pull nomic-embed-text
WOT_RELAYS=wss://nos.lol
WOT_MAX_RELAYS=1
WOT_MAX_SEED_ZAPS=20
WOT_MAX_CO_ZAPPERS=20
WOT_MAX_ZAPS_PER_CO_ZAPPER=20
