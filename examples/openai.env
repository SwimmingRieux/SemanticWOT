# Runtime backend settings. Copy ONE provider example to .env.
# Supply your own key; notes are sent to the selected OpenAI service for embedding.
OPENAI_API_KEY=replace-with-your-key
WOT_OPENAI_ENDPOINT=https://api.openai.com/v1
# WOT_ENDPOINT must be absent for OpenAI. An empty setting is an error.
# Defaults: text-embedding-3-small, 1536 dimensions, batch size 32.
WOT_RELAYS=wss://nos.lol
WOT_MAX_RELAYS=1
WOT_MAX_SEED_ZAPS=20
WOT_MAX_CO_ZAPPERS=20
WOT_MAX_ZAPS_PER_CO_ZAPPER=20
